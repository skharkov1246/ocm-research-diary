   "values_eV_dZPE_minus_TdS": {
    "OH*": 0.35,
    "O*": 0.05,
    "OOH*": 0.4
   },
   "note": "Applied to adsorbate formation energies; gas-reference ZPE/TS already included in these aggregates. Hessians were NOT computed for this cluster -- these numbers are not ours."
  },
  "limitations": [
   "minimal cluster: no extended NiOOH lattice, Ni oxidation state not pinned to III/IV",
   "frozen Ni/O core is a crude lattice mimic",
