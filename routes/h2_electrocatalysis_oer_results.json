  "o2_reference": {
   "how": "G(O2) := 2 G(H2O) - 2 G(H2) + 4.92 eV (experimental water-splitting dG); equivalently dG4 = 4.92 - sum(dG1..3)",
   "why": "PBE triplet O2 has a notorious ~0.3-0.7 eV binding error; direct O2 DFT deliberately avoided (standard CHE practice)"
  },
